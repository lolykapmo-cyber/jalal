# ============================================================
#  مطلوب / Required
# ============================================================

# احصل عليه من @BotFather على تليكرام
# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe


# ============================================================
#  الصلاحيات / Access control
# ============================================================

# أرقام المستخدمين المسموح لهم (فارغ = البوت متاح للجميع)
# Numeric user IDs allowed to use the bot. Empty = open to everyone.
ALLOWED_USERS=

# المشرفون: يملكون /stats ويمكنهم تحديث ملف الكوكيز
# Admins: can run /stats and upload a new cookies.txt
ADMIN_USERS=


# ============================================================
#  الاشتراك الإجباري / Mandatory subscription
# ============================================================

# قنوات يجب على المستخدم الاشتراك فيها قبل أن يرد البوت.
# افصل بفاصلة. الصيغ المقبولة: @اسم_القناة، أو رابط t.me،
# أو معرّف رقمي 100- لقناة خاصة متبوعاً بـ | ورابط الدعوة.
# مثال: @chan_one,https://t.me/chan_two,-1001234567890|https://t.me/+abc
#
# مهم: البوت يجب أن يكون *مشرفاً* في كل قناة، وإلا فتليكرام لا
# يسمح له بقراءة الأعضاء ولا يمكن تطبيق الشرط.
#
# Channels a user must join before the bot answers. Comma-separated.
# Accepts @name, a t.me link, or a -100 id followed by |invite-link.
# The bot MUST be an administrator of each channel, otherwise Telegram
# refuses the membership query and the requirement cannot be enforced.
REQUIRED_CHANNELS=

# مدة تذكّر أن المستخدم مشترك، بالثواني (يقلّل الضغط على تليكرام)
# How long a verified membership is remembered, in seconds.
MEMBERSHIP_CACHE_SECONDS=300

# true: إن تعذّر على البوت فحص العضوية (ليس مشرفاً مثلاً) يسمح بالمرور.
# اتركه true: الخطأ في الإعداد سيُغلق البوت أمام الجميع لو كان false.
# true: if the bot cannot check membership (e.g. it is not an admin),
# let the user through. Keep it true: with false, one misconfiguration
# locks every user out of a working bot.
MEMBERSHIP_FAIL_OPEN=true


# ============================================================
#  حدود الرفع / Upload limits
# ============================================================

# الحد الأقصى لرفع الملفات. 50 ميغابايت هو حد Bot API العام.
# لرفع ملفات تصل إلى 2 غيغابايت، شغّل سيرفر Bot API محلي وحدّد
# TELEGRAM_API_ROOT أدناه؛ سيرتفع الحد تلقائياً إلى 2000.
# Max upload size. 50 MB is the public Bot API ceiling. For up to 2 GB,
# run a local Bot API server and set TELEGRAM_API_ROOT below; the limit
# then defaults to 2000.
# UPLOAD_LIMIT_MB=50

# عنوان سيرفر Bot API المحلي (اتركه فارغاً لاستخدام سيرفر تليكرام)
# Local Bot API server root. Leave empty to use Telegram's own servers.
# TELEGRAM_API_ROOT=http://telegram-bot-api:8081

# إعادة ترميز الملفات الأكبر من الحد لتناسبه، بدل رفضها
# Re-encode files above the limit to fit, instead of refusing them.
TRANSCODE_OVERSIZED=true


# ============================================================
#  الاستخدام العادل / Fair use
# ============================================================

# عدد التحميلات المتوازية على مستوى البوت كله
# How many downloads run at once, bot-wide.
MAX_CONCURRENT_DOWNLOADS=3

# عدد التحميلات المتوازية لكل مستخدم
# How many downloads one user may run at once.
MAX_USER_DOWNLOADS=1

# مدة الانتظار بين طلبين لنفس المستخدم (بالثواني)
# Seconds a user must wait between requests.
COOLDOWN_SECONDS=3

# أقصى مدة فيديو مسموحة بالثواني (الافتراضي 3 ساعات)
# Maximum video duration in seconds (default: 3 hours).
MAX_DURATION_SECONDS=10800

# عدد عناصر قائمة التشغيل التي تُحمّل (1 = الفيديو المطلوب فقط)
# Playlist items to download. 1 = just the linked video.
MAX_PLAYLIST_ITEMS=1

# عدد المحاولات بطرق مختلفة قبل الاستسلام. البوت ينتحل عملاء مختلفين
# (تطبيق تلفاز، هاتف، متصفح حقيقي) وهذا ما يُغني عن الكوكيز. زيادته
# ترفع نسبة النجاح وتزيد وقت الانتظار عند الفشل.
# How many different clients to try before giving up. The bot presents
# itself as a TV app, a phone app or a real browser; this is what replaces
# cookies. Higher = better success rate, longer wait when a link is dead.
MAX_DOWNLOAD_ATTEMPTS=4


# ============================================================
#  السلوك الافتراضي / Default behaviour
# ============================================================

# ar أو en
# ar or en
DEFAULT_LANGUAGE=ar

# best | 1080 | 720 | 480 | 360 | audio
DEFAULT_QUALITY=best

# true: اسأل عن الجودة بأزرار. false: حمّل فوراً بالجودة الافتراضية.
# true: show a quality keyboard. false: download immediately.
ASK_QUALITY=true


# ============================================================
#  المسارات والشبكة / Paths and network
# ============================================================

# مجلد التحميل المؤقت (يُفرَّغ بعد كل مهمة)
# Scratch directory for downloads; cleaned after every job.
WORK_DIR=downloads

# قاعدة بيانات الإعدادات والذاكرة المؤقتة
# SQLite database for preferences and the upload cache.
DATABASE_PATH=data/bot.sqlite3

# مدة الاحتفاظ بالملفات المرفوعة في الذاكرة المؤقتة (بالساعات، 0 = للأبد)
# How long to reuse an uploaded file_id, in hours. 0 = forever.
CACHE_TTL_HOURS=72

# اختياري وغير مستحسن: ملف كوكيز بصيغة Netscape. البوت لا يحتاجه —
# يجرّب عدة عملاء بدلاً منه. استخدمه فقط لمحتوى خاص تملكه، وبحساب
# ثانوي، فالكوكيز تمنح وصولاً كاملاً للحساب وقد تُحظر عليه المنصّة.
# Optional and not recommended: a Netscape-format cookies file. The bot
# does not need one; it tries several clients instead. Use it only for
# private content you own, from a throwaway account: cookies grant full
# account access and platforms do ban accounts for automated use.
# COOKIES_FILE=cookies.txt

# بروكسي يستخدمه yt-dlp (مفيد لتجاوز الحجب الجغرافي)
# Proxy for yt-dlp; useful against geo-blocks.
# PROXY=socks5://127.0.0.1:9050

# أقل مساحة حرة مطلوبة قبل بدء أي تحميل (ميغابايت).
# يرفض البوت التحميل بأدب بدل أن يملأ القرص.
# Minimum free disk space before starting a download, in MB. The bot
# refuses politely rather than filling the volume.
MIN_FREE_DISK_MB=1024

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
